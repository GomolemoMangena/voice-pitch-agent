{
  "name": "voice-pitch-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "vite --port 5180 --strictPort",
    "build:dashboard": "vite build --mode dashboard",
    "dev:server": "tsx watch server/index.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@elevenlabs/react": "^1.23.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
