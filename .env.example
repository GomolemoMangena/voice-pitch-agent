# Copy this file to .env. The real file is gitignored.
# The key stays on the server and is never sent to the browser.

# ElevenLabs API key. It needs voices_read, text_to_speech, convai_read, and convai_write.
ELEVENLABS_API_KEY=

# Filled in automatically the first time a call can create the agent.
ELEVENLABS_AGENT_ID=

# Active conversation model. elevenlabs is the only connected provider.
# grok is reserved for a later integration and is not available yet.
AI_PROVIDER=elevenlabs
